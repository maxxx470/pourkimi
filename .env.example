# ==========================================
# MÉTRIO — CONFIGURATION ENVIRONNEMENT (PHASE 1)
# ==========================================

# --- CONFIGURATION CLIENT (VITE PUBLIC) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_API_URL="http://localhost:3000"

# --- CONFIGURATION SERVEUR (EXPRESS SECRETS) ---
PORT=3000
NODE_ENV="development"
ALLOWED_ORIGINS="https://metrio.app,http://localhost:5173"

# Clé de l'API Claude Anthropic pour l'analyse intelligente des plans
ANTHROPIC_API_KEY="your-anthropic-key"

# Identifiants d'accès administrateur à Supabase (utilisé pour contourner la RLS côté serveur)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Clé API pour les envois d'emails transactionnels (Resend)
RESEND_API_KEY="re_your-resend-key"

# Clé API pour la conversion de plans DWG en PDF (CloudConvert)
CLOUDCONVERT_API_KEY="your-cloudconvert-key"
